#!/bin/bash
# Долгие задачи на devbox отдельно от SSH: обрыв связи их не убивает.
#   devjob start <имя> <команда…>  — запустить в фоне (setsid+nohup), журнал ~/jobs/<имя>.log
#   devjob status <имя>             — идёт / завершена с кодом N
#   devjob log <имя> [строк]        — хвост журнала
#   devjob stop <имя>               — остановить всю группу процессов
set -e; cmd=${1:-}; name=${2:-}; D="$HOME/jobs"
[ -z "$cmd" ] || [ "$cmd" = help ] && { sed -n 2,6p "$0"; exit 0; }
[ -n "$name" ] || { echo "укажите имя"; exit 2; }
case $cmd in
  start) shift 2; [ -s "$D/$name.pid" ] && kill -0 "$(cat "$D/$name.pid")" 2>/dev/null && { echo "уже идёт"; exit 1; }
         : > "$D/$name.exit"
         setsid nohup bash -c ". ~/netrun-env.sh; cd ~/megablock10; $*; echo \$? > \"$D/$name.exit\"" > "$D/$name.log" 2>&1 < /dev/null &
         echo $! > "$D/$name.pid"; echo "запущено: $name (pid $!)";;
  status) if [ -s "$D/$name.exit" ]; then echo "завершена, код $(cat "$D/$name.exit")"
          elif [ -s "$D/$name.pid" ] && kill -0 "$(cat "$D/$name.pid")" 2>/dev/null; then echo "идёт"; else echo "нет такой задачи"; fi;;
  log) tail -n "${3:-30}" "$D/$name.log";;
  stop) kill -TERM -- "-$(cat "$D/$name.pid")" 2>/dev/null && echo остановлено || echo "не идёт";;
  *) sed -n 2,6p "$0";;
esac
