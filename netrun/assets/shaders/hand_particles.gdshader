// Руки игрока: облако светящихся точек и искр на костях (client/hand_view.gd). Один MultiMesh на руку, один квадрат на частицу;
// позицию задаёт экземпляр (обновляется каждый кадр из позы контроллера или трекинга), остальное — данные экземпляра:
//   COLOR — цвет свечения; INSTANCE_CUSTOM: x — полуразмер, м; y — фаза вдоль руки 0 (запястье) … 1 (кончики); z — вид (0 точка, 1 искра); w — яркость 0…1.
// «Объёмный дисплей»: центры точек прищёлкиваются к мировой решётке lattice (как у существ), поэтому рука собрана из воксельных огоньков.
// Аддитивно, без освещения, без проверки глубины: рука видна всегда (её не закрывают ни плитки, ни стены) и просвечивает, не загораживая то, что в неё берут.
shader_type spatial;
render_mode blend_add, unshaded, depth_draw_never, depth_test_disabled, cull_disabled, fog_disabled;  // без проверки глубины: рука видна всегда, её не закрывают ни плитки, ни стены

#include "particles_body.gdshaderinc"
