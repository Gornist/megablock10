// «Кромка внутрь» (ручка AssetMaterials `edge_soft`, solid_dark и fringe): единственная жёсткая ступенька у светящихся рёбер — геометрический силуэт, где яркая вершина (доля света k = 1)
// граничит с тёмным фоном: без MSAA это лесенка. Рёбра укрытий, тайлов и брусьев уже запечены градиентом 1 → 0 на 3 см вглубь грани, поэтому пик яркости можно
// сдвинуть с самого края на 1–1,5 см внутрь: у силуэта свет гасится до (1 − e), а пик нормируется обратно в полную яркость. Силуэт становится «тёмное по тёмному»,
// яркая линия — плавный градиент внутри грани (его края уже гладкие). e = 0 — как раньше.
// k — доля света вершины 0…1 (наибольший канал цвета; у базовой подсветки ≤ 0,6 мера почти не действует).

float edge_soft_gain(float k, float e) {
	if (e <= 0.0) {
		return 1.0;
	}
	float s = smoothstep(0.55, 1.0, k);
	return (1.0 - e * s) / (1.0 - 0.52 * e);   // 0,52 — просадка пика после сдвига (замер при e = 0,8: пик 0,585 → нормировка в 1)
}

// Мягкий клип пересвета с сохранением оттенка (ручка albedo_clip): яркость кромок edge_glow 2,2 × циан даёт каналы > 1 (до 2,2), тонмаппинг и усреднение подвыборок MSAA
// сдвигают такой пиксель к белому, и тонкие яркие линии мигают белым. Если наибольший канал > 1, цвет делится на него (в долях k): циан остаётся цианом. k = 0 — как раньше.
vec3 soft_clip(vec3 c, float k) {
	float m = max(c.r, max(c.g, c.b));
	return m > 1.0 ? c * mix(1.0, 1.0 / m, k) : c;
}
