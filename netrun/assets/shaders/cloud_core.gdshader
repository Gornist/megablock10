// Непрозрачный сердечник под облаком граней (ручка AssetMaterials `cloud_core`, слово владельца 15.11: «колонны всё ещё прозрачные — я вижу, что за ними»;
// «колонны рендерятся частично, что-то обрезает их по горизонтали» — это рёбра укрытий позади колонны, видные сквозь частицы).
// Второй проход того же меша (next_pass облачного материала): сплошной цвет пустоты, утоплен по нормали на core_sink, чтобы частицы на самой грани не резались
// его глубиной. Рисуется в непрозрачном проходе (до облака): закрывает то, что позади, и заднюю сторону самого объекта; частицы позади отсекаются глубиной.
shader_type spatial;
render_mode unshaded, cull_back, fog_disabled, shadows_disabled;

uniform float core_sink : hint_range(0.0, 0.1) = 0.01;   // м: насколько сердечник утоплен внутрь от грани
uniform vec3 core_color : source_color = vec3(0.0);       // = AssetMaterials.VOID_BG (цвет очистки): сердечник не виден как форма, только закрывает

void vertex() {
	VERTEX -= NORMAL * core_sink;
}

void fragment() {
	ALBEDO = core_color;
}
