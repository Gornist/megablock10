<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Presence/чат: NSD (mDNS) + прямой TCP между устройствами в одной Wi-Fi сети, без интернета. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Без этого WebRTC падает насмерть: его внутренний NetworkMonitor дёргает
         ConnectivityManager.getActiveNetworkInfo() при старте PeerConnection,
         SecurityException без разрешения улетает через JNI, а WebRTC трактует
         любое необработанное Java-исключение там как fatal (abort()). Поймано
         вживую на эмуляторе — SIGABRT в network_thread при первом же звонке. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork/bindProcessToNetwork: привязка трафика приложения к Wi-Fi игровой сети (presence/WifiBinder) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Требуется на Android 13+ для обнаружения устройств по Wi-Fi (NSD в т.ч.); на более старых версиях игнорируется. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:targetApi="33" />

    <!-- Голосовые звонки (WebRTC): захват с микрофона + сам факт разрешения, запрашиваемого рантаймом перед звонком. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Foreground-сервис на время звонка — без него Android 14 отбирает микрофон у свёрнутого/фонового процесса. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Foreground-сервис на всё время сессии персонажа — без него фоновый процесс рано или поздно замораживается, и приём чата/звонков встаёт до открытия приложения заново (presence/MeshForegroundService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Само CallStyle-уведомление на Android 13+ не покажется без этого — сервис при этом всё равно запустится и будет жить, просто плашка будет не видна игроку. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".Mb10App"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CaptureActivity для сканера QR уже объявлена в манифесте
             библиотеки zxing-android-embedded и подтянется автоматически
             при слиянии манифестов — здесь её дублировать не нужно. -->

        <!-- Отдача архива журнала через «Поделиться»: только папка cache/log-export. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".presence.MeshForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.megablok10.app.call.ACTION_HANG_UP" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
